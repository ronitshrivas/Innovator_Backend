{
  "Urls": "http://localhost:5000",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "username-check-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/users/check-username" }
      },
      "profile-route": {
        "ClusterId": "profile-cluster",
        "Match": { "Path": "/api/profile/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "profile-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": { "Address": "http://localhost:8010/" }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "profile-service": { "Address": "http://localhost:8011/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  }
}
