{
  "Urls": "http://localhost:5000",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "username-check-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/users/check-username" }
      },
      "profile-route": {
        "ClusterId": "profile-cluster",
        "Match": { "Path": "/api/profile/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "profile-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "feed-route": {
        "ClusterId": "feed-cluster",
        "Match": { "Path": "/api/feed/{**catch-all}" }
      },
      "posts-route": {
        "ClusterId": "feed-cluster",
        "Match": { "Path": "/api/posts/{**catch-all}" }
      },
      "reels-route": {
        "ClusterId": "feed-cluster",
        "Match": { "Path": "/api/reels/{**catch-all}" }
      },
      "reactions-route": {
        "ClusterId": "feed-cluster",
        "Match": { "Path": "/api/reactions/{**catch-all}" }
      },
      "comments-route": {
        "ClusterId": "feed-cluster",
        "Match": { "Path": "/api/comments/{**catch-all}" }
      },
      "replies-route": {
        "ClusterId": "feed-cluster",
        "Match": { "Path": "/api/replies/{**catch-all}" }
      },
      "feed-categories-route": {
        "ClusterId": "feed-cluster",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "chat-route": {
        "ClusterId": "chat-cluster",
        "Match": { "Path": "/api/chat/{**catch-all}" }
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": { "Path": "/api/search/{**catch-all}" }
      },
      "suggested-users-route": {
        "ClusterId": "search-cluster",
        "Match": { "Path": "/api/suggested-users/{**catch-all}" }
      },
      "products-route": {
        "ClusterId": "ecommerce-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "cart-route": {
        "ClusterId": "ecommerce-cluster",
        "Match": { "Path": "/api/cart-items/{**catch-all}" }
      },
      "checkout-route": {
        "ClusterId": "ecommerce-cluster",
        "Match": { "Path": "/api/checkout/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "ecommerce-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payments-route": {
        "ClusterId": "ecommerce-cluster",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "payment-qrs-route": {
        "ClusterId": "ecommerce-cluster",
        "Match": { "Path": "/api/payment-qrs/{**catch-all}" }
      },
      "fcm-tokens-route": {
        "ClusterId": "ecommerce-cluster",
        "Match": { "Path": "/api/fcm-tokens/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "ecommerce-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": { "Address": "http://localhost:8010/" }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "profile-service": { "Address": "http://localhost:8011/" }
        }
      },
      "feed-cluster": {
        "Destinations": {
          "feed-service": { "Address": "http://localhost:8012/" }
        }
      },
      "chat-cluster": {
        "Destinations": {
          "chat-service": { "Address": "http://localhost:8014/" }
        }
      },
      "search-cluster": {
        "Destinations": {
          "search-service": { "Address": "http://localhost:8015/" }
        }
      },
      "ecommerce-cluster": {
        "Destinations": {
          "ecommerce-service": { "Address": "http://localhost:8016/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  }
}
